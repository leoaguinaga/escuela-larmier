            <form class="border border-white/20 border-t-4 border-t-primary bg-white p-6 md:p-8 grid gap-5 shadow-2xl">
                <div><span class="font-label-md text-label-md text-secondary uppercase">Solicita información</span><h3 class="font-headline-md text-3xl text-on-surface uppercase mt-2">Cuéntanos qué quieres operar</h3></div>
