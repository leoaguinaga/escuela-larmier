---
const steps = [
    { number: '01', title: 'Teoría aplicada', body: 'Seguridad, reconocimiento de mandos, mantenimiento básico y lectura del entorno.' },
    { number: '02', title: 'Práctica progresiva', body: 'Maniobras esenciales, control del equipo y corrección directa con instructor.' },
    { number: '03', title: 'Certificación individual', body: 'Obtén una constancia específica por cada máquina que completes.' },
];
---
<section id="metodo" class="py-24 bg-surface-container overflow-hidden scroll-mt-20">
    <div class="px-margin-mobile md:px-margin-desktop max-w-container-max mx-auto">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-20 items-center">
            <div class="relative">
                <div class="absolute -left-4 -top-4 w-32 h-32 bg-primary"></div>
                <img class="relative z-10 w-full h-[560px] object-cover border-[6px] border-white shadow-2xl" src="/images/larminer-metodo-practico.webp" alt="Instructor guiando a un estudiante en los controles de una excavadora" loading="lazy" />
                <div class="absolute z-20 right-0 bottom-8 bg-surface-dim text-white px-6 py-4 border-l-4 border-primary"><strong class="font-headline-md text-headline-md uppercase block">Aprende en campo</strong><span class="text-white/65">No solo en aula</span></div>
            </div>
            <div>
                <p class="font-label-md text-label-md text-secondary uppercase mb-3">Método Larminer</p>
                <h2 class="font-headline-lg text-headline-lg text-on-surface mb-6 leading-tight uppercase">Del primer mando a una operación segura</h2>
                <p class="font-body-lg text-body-lg text-on-surface-variant mb-9">Aprendes con una ruta clara: comprendes el equipo, practicas con acompañamiento y demuestras tus habilidades en maquinaria real.</p>
                <div class="space-y-4">
                    {steps.map((step) => (
                        <div class="grid grid-cols-[56px_1fr] gap-4 items-start bg-white p-5 border border-outline-variant">
                            <span class="font-headline-md text-headline-md text-primary bg-surface-dim w-14 h-14 flex items-center justify-center">{step.number}</span>
                            <div><h3 class="font-headline-md text-headline-md text-secondary uppercase">{step.title}</h3><p class="font-body-md text-body-md text-on-surface-variant">{step.body}</p></div>
                        </div>
                    ))}
                </div>
            </div>
        </div>
    </div>
</section>
