---
const machines = [
    { name: 'Excavadora hidráulica', body: 'Movimiento de tierra, zanjado, carguío y trabajo seguro en frentes de excavación.', image: '/images/larminer-metodo-practico.webp', position: 'object-center' },
    { name: 'Retroexcavadora', body: 'Operación versátil para obras urbanas, carga, excavación y mantenimiento vial.', image: '/images/larminer-hero-training.webp', position: 'object-[72%_center]' },
    { name: 'Motoniveladora', body: 'Nivelación, acabado superficial, conformación de vías y control de pendientes.', image: 'https://lh3.googleusercontent.com/aida-public/AB6AXuAxsTsoOxc3Nsh8ZYY7EXFA_J-80-k495tJab1fO3F4dy5E2lZ_MEgJ1ZjoqnhjuZCtWynDwDcyWGzRaF9JiLcX3utxYo3y1cREJPb84Pn4KoOHLzrDahCfBKJ0W5ZNaWHavtqmi2bbRk26A3f1eQEd5nSXo86wzGRf3mjM3IHI5S94mOcwMgjThqJAeGLUiFbC1cWph5rLuyYvpPUsDX5hnRQ88y0pjP9hcb9BhhAFZPdNlV55skVSSc95jX45QjX5veeYNSq76gw', position: 'object-center' },
    { name: 'Cargador frontal', body: 'Carga, acarreo corto, abastecimiento y maniobras en patios de operación.', image: 'https://images.unsplash.com/photo-1751054786365-4b02b690d301?auto=format&fit=crop&q=85&w=1200', position: 'object-center' },
    { name: 'Rodillo compactador', body: 'Compactación de suelos, control de pasadas y criterios básicos de acabado.', image: 'https://images.unsplash.com/photo-1776381733574-372689e246b4?auto=format&fit=crop&q=85&w=1200', position: 'object-center' },
    { name: 'Bulldozer', body: 'Empuje, corte, extendido de material y operación en terrenos exigentes.', image: 'https://images.unsplash.com/photo-1678512680110-19a1e548585c?auto=format&fit=crop&q=85&w=1200', position: 'object-center' },
];
---
<section id="maquinas" class="py-24 bg-surface scroll-mt-20">
    <div class="px-margin-mobile md:px-margin-desktop max-w-container-max mx-auto">
        <div class="grid lg:grid-cols-[1fr_auto] gap-6 items-end mb-12">
            <div><p class="font-label-md text-label-md text-secondary uppercase mb-3">Entrena con maquinaria real</p><h2 class="font-headline-lg text-headline-lg text-on-surface uppercase mb-4">Seis máquinas. Una formación completa.</h2><p class="font-body-lg text-body-lg text-on-surface-variant max-w-2xl">Construye un perfil técnico versátil para obra, mina, campo y logística.</p></div>
            <div class="hidden lg:block bg-primary text-on-primary font-headline-md text-headline-md px-6 py-4 uppercase font-bold">100% práctica real</div>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-gutter">
            {machines.map((machine, index) => (
                <article class="bg-white border border-outline-variant group overflow-hidden shadow-[0_8px_30px_rgba(6,40,70,.08)] hover:-translate-y-1 transition-transform duration-300">
                    <div class="h-64 overflow-hidden relative">
                        <img class={`w-full h-full object-cover ${machine.position} group-hover:scale-105 transition-transform duration-500`} src={machine.image} alt={machine.name} loading="lazy" />
                        <span class="absolute left-0 bottom-0 bg-primary text-on-primary font-headline-md text-headline-md font-bold px-4 py-2">0{index + 1}</span>
                    </div>
                    <div class="p-6 border-t-4 border-primary"><h3 class="font-headline-md text-headline-md text-secondary mb-2 uppercase">{machine.name}</h3><p class="font-body-md text-body-md text-on-surface-variant">{machine.body}</p></div>
                </article>
            ))}
        </div>
    </div>
</section>
