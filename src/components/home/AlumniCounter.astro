---
const stats = [
    { value: 'S/ 1,700', label: 'a S/ 2,000 al mes', body: 'Rango referencial para operadores certificados en el mercado peruano.' },
    { value: '11 meses', label: 'duración típica', body: 'Tiempo estimado para una formación técnica completa y progresiva.' },
    { value: '4 sectores', label: 'con demanda', body: 'Minería, construcción, agricultura y logística buscan perfiles técnicos.' },
];
---
<section id="demanda" class="py-20 bg-surface-dim scroll-mt-20 relative overflow-hidden">
    <div class="absolute inset-y-0 right-0 w-1/3 hazard-stripes opacity-40"></div>
    <div class="px-margin-mobile md:px-margin-desktop max-w-container-max mx-auto relative">
        <div class="max-w-3xl mb-12"><p class="font-label-md text-label-md text-primary uppercase mb-3">Oportunidad en Perú</p><h2 class="font-headline-lg text-headline-lg text-white uppercase mb-4">Una carrera técnica que mueve al país</h2><p class="font-body-lg text-body-lg text-white/70">La maquinaria pesada abre camino en minería, construcción, logística portuaria y agricultura tecnificada.</p></div>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            {stats.map((stat) => (
                <div class="p-7 border border-white/20 border-t-4 border-t-primary bg-white/5 backdrop-blur-sm">
                    <div class="font-headline-xl text-5xl text-primary mb-2">{stat.value}</div>
                    <div class="font-headline-md text-headline-md uppercase text-white">{stat.label}</div>
                    <p class="font-body-md text-body-md text-white/65 mt-3">{stat.body}</p>
                </div>
            ))}
        </div>
    </div>
</section>
