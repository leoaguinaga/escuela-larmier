---
import { courses } from "../../data/courses";
import CourseCard from "./CourseCard.astro";
import CourseFilters from "./CourseFilters.astro";
---

<section class="bg-surface py-16 md:py-24" aria-labelledby="catalog-title">
  <div class="mx-auto max-w-container-max px-margin-mobile md:px-margin-desktop">
    <div class="mb-10 max-w-3xl">
      <p class="mb-3 font-label-md text-sm font-semibold uppercase tracking-[.12em] text-secondary">Catálogo formativo</p>
      <h2 id="catalog-title" class="font-headline-lg text-4xl font-bold uppercase leading-none text-on-surface md:text-5xl">
        Elige la máquina que quieres dominar
      </h2>
    </div>

    <div class="flex flex-col gap-10 lg:flex-row lg:gap-12">
      <CourseFilters />

      <div class="min-w-0 flex-1">
        <div class="mb-7 flex flex-col gap-4 border-b border-outline-variant pb-5 sm:flex-row sm:items-center sm:justify-between">
          <p id="course-count" class="text-on-surface-variant" aria-live="polite">
            Mostrando <strong class="text-on-surface">{courses.length}</strong> programas formativos
          </p>
          <label class="flex items-center gap-3 text-sm font-semibold uppercase tracking-wider text-on-surface-variant">
            Ordenar por
            <select id="course-sort" class="border border-outline-variant bg-white px-4 py-2.5 font-body-md text-base font-normal normal-case tracking-normal text-on-surface outline-none focus:border-primary focus:ring-2 focus:ring-primary/30">
              <option value="relevance">Relevancia</option>
              <option value="duration-asc">Duración: menor a mayor</option>
              <option value="duration-desc">Duración: mayor a menor</option>
            </select>
          </label>
        </div>

        <div id="course-grid" class="grid grid-cols-1 gap-6 md:grid-cols-2 xl:grid-cols-3">
          {courses.map((course) => <CourseCard course={course} />)}
        </div>
        <p id="course-empty" class="hidden border border-outline-variant bg-white p-8 text-center text-on-surface-variant">
          No hay programas que coincidan con estos filtros. Prueba seleccionando otro nivel o categoría.
        </p>
      </div>
    </div>
  </div>
</section>

<script>
  const filterForm = document.querySelector<HTMLFormElement>("#course-filters");
  const sortControl = document.querySelector<HTMLSelectElement>("#course-sort");
  const grid = document.querySelector<HTMLElement>("#course-grid");
  const count = document.querySelector<HTMLElement>("#course-count");
  const empty = document.querySelector<HTMLElement>("#course-empty");

  const updateCatalog = () => {
    if (!filterForm || !sortControl || !grid || !count || !empty) return;

    const formData = new FormData(filterForm);
    const category = String(formData.get("category") ?? "all");
    const levels = formData.getAll("level").map(String);
    const cards = Array.from(grid.querySelectorAll<HTMLElement>(".course-card"));

    const visibleCards = cards.filter((card) => {
      const categoryMatches = category === "all" || card.dataset.category === category;
      const levelMatches = levels.includes(card.dataset.level ?? "");
      const isVisible = categoryMatches && levelMatches;
      card.hidden = !isVisible;
      return isVisible;
    });

    if (sortControl.value !== "relevance") {
      const direction = sortControl.value === "duration-asc" ? 1 : -1;
      cards
        .sort((a, b) => direction * (Number(a.dataset.duration) - Number(b.dataset.duration)))
        .forEach((card) => grid.append(card));
    } else {
      cards
        .sort((a, b) => (a.dataset.name ?? "").localeCompare(b.dataset.name ?? "", "es"))
        .forEach((card) => grid.append(card));
    }

    count.innerHTML = `Mostrando <strong class="text-on-surface">${visibleCards.length}</strong> ${visibleCards.length === 1 ? "programa formativo" : "programas formativos"}`;
    empty.classList.toggle("hidden", visibleCards.length !== 0);
  };

  filterForm?.addEventListener("change", updateCatalog);
  sortControl?.addEventListener("change", updateCatalog);
</script>
