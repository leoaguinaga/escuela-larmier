---
---
<section class="py-24 bg-surface scroll-mt-20">
  <div class="px-margin-mobile md:px-margin-desktop max-w-container-max mx-auto">
    <div class="max-w-xl mx-auto bg-white border border-outline-variant border-t-4 border-t-primary p-6 md:p-8 shadow-[0_8px_30px_rgba(6,40,70,.08)]">
      <p class="font-label-md text-label-md text-secondary uppercase mb-2">Paso 1</p>
      <h2 class="font-headline-md text-3xl text-on-surface uppercase mb-4">Ingresa el código</h2>
      <p class="font-body-md text-body-md text-on-surface-variant mb-6">
        El código está impreso debajo del QR del certificado. Ejemplo:
        <a class="font-bold text-secondary underline hover:text-primary" href="/verificar/LAR-2026-000347">LAR-2026-000347</a>
      </p>
      <form id="verify-form" class="grid gap-4">
        <label class="grid gap-2">
          <span class="font-label-md text-label-md text-on-surface uppercase">Código de certificado</span>
          <input
            id="verify-code"
            class="bg-surface border border-outline-variant px-4 py-3 text-on-surface uppercase tracking-wide focus:border-primary outline-none font-headline-md text-headline-md"
            type="text"
            name="codigo"
            placeholder="LAR-2026-000000"
            autocomplete="off"
            required
          />
        </label>
        <button
          type="submit"
          class="bg-primary text-on-primary font-headline-md text-headline-md px-8 py-4 font-bold uppercase border-b-4 border-[#bd8700] active:translate-y-1 active:border-b-0 transition-all hover:bg-primary-container inline-flex items-center justify-center gap-2"
        >
          <span class="material-symbols-outlined text-2xl" aria-hidden="true">search</span>
          Verificar
        </button>
      </form>
    </div>
  </div>
</section>

<script>
  const form = document.getElementById('verify-form') as HTMLFormElement | null;
  const input = document.getElementById('verify-code') as HTMLInputElement | null;

  form?.addEventListener('submit', (event) => {
    event.preventDefault();
    const code = input?.value.trim().toUpperCase();
    if (!code) return;
    window.location.href = `/verificar/${encodeURIComponent(code)}`;
  });
</script>
